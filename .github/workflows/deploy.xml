name: Laravel & React CI/CD Pipeline

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  # ========================================================
  # ১. CI: কোড টেস্ট ও ফ্রন্টএন্ড এসেট বিল্ড (আসল MySQL সহ)
  # ========================================================
  tests:
    name: 🧪 Run Tests & Build Assets
    runs-on: ubuntu-latest

    # GitHub Actions-এর ভেতরেই একটি ব্যাকগ্রাউন্ড MySQL কনটেইনার চলবে
    services:
      mysql:
        image: mysql:8.0
        env:
          MYSQL_ROOT_PASSWORD: root
          MYSQL_DATABASE: practice
          MYSQL_USER: practice
          MYSQL_PASSWORD: practice
        ports:
          - 3306:3306
        options: --health-cmd="mysqladmin ping" --health-interval=10s --health-timeout=5s --health-retries=3

    steps:
      # রিপোজিটরি কোড ডাউনলোড
      - name: Checkout Code
        uses: actions/checkout@v4

      # PHP 8.3 ও MySQL এক্সটেনশন সেটআপ
      - name: Setup PHP Environment
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.3'
          extensions: mbstring, dom, fileinfo, pdo, pdo_mysql, gd, zip, bcmath, intl
          coverage: none

      # Node.js 20 সেটআপ (React ও Vite এর জন্য)
      - name: Setup Node.js Environment
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      # Composer প্যাকেজ ইনস্টল
      - name: Install Composer Dependencies
        run: composer install -q --no-ansi --no-interaction --no-scripts --no-progress --prefer-dist

      # React ফ্রন্টএন্ড এসেট বিল্ড
      - name: Install NPM & Build Vite Assets
        run: |
          npm install
          npm run build

      # লারাভেল কনফিগারেশন ও মাইগ্রেশন
      - name: Setup Environment & Run Migrations
        env:
          DB_CONNECTION: mysql
          DB_HOST: 127.0.0.1
          DB_PORT: 3306
          DB_DATABASE: practice
          DB_USERNAME: practice
          DB_PASSWORD: practice
        run: |
          cp .env.example .env
          php artisan key:generate
          php artisan migrate --force

      # স্বয়ংক্রিয় টেস্ট রান
      - name: Run Automated Tests
        env:
          DB_CONNECTION: mysql
          DB_HOST: 127.0.0.1
          DB_PORT: 3306
          DB_DATABASE: practice
          DB_USERNAME: practice
          DB_PASSWORD: practice
        run: php artisan test

  # ========================================================
  # ২. CD: ডকার ইমেজ তৈরি (ডিপ্লয়মেন্টের জন্য প্রস্তুত করা)
  # ========================================================
  docker-build:
    name: 🐳 Build Docker Image
    needs: tests # টেস্ট সফল হলেই কেবল ডকার ইমেজ তৈরি হবে
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # ডকার ইঞ্জিন প্রস্তুত করা
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # আপনার Dockerfile থেকে ইমেজ বিল্ড করা
      - name: Build Docker Container
        run: |
          docker build -t practice-app:latest .
          echo "🎉 Docker image successfully built and ready for production!"
